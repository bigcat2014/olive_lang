{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
			"type": "cmake",
			"label": "CMake: install",
			"command": "build",
			"targets": [
				"install"
			],
			"group": "none",
			"problemMatcher": [],
			"detail": "CMake template install task"
		},
		{
			"type": "shell",
			"label": "CMake: Run Tests",
			"command": "ctest",
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"group": "none",
			"problemMatcher": [],
			"detail": "Run unit tests"
		}
	]
}