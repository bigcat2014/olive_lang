{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "cmake",
			"label": "CMake: build",
			"command": "build",
			"targets": [
				"all"
			],
			"group": "build",
			"problemMatcher": [],
			"detail": "CMake template build task"
		},
		{
			"type": "cmake",
			"label": "CMake: install",
			"command": "build",
			"targets": [
				"install"
			],
			"group": "none",
			"problemMatcher": [],
			"detail": "CMake template install task"
		},
		{
			"type": "shell",
			"label": "CMake: Run Tests",
			"command": "ctest; exit 0", // Always exit 0 to allow future tasks to continue
			"options": {
				"cwd": "${workspaceFolder}/build"
			},
			"group": "none",
			"problemMatcher": [],
			"detail": "Run unit tests",
			"dependsOrder": "sequence",
			"dependsOn": [
				"CMake: build"
			]
		},
		{
			"type": "cmake",
			"label": "CMake: coverage",
			"command": "build",
			"targets": [
				"coverage"
			],
			"group": "none",
			"problemMatcher": [],
			"detail": "CMake template coverage task",
			"dependsOrder": "sequence",
			"dependsOn": [
				"CMake: Run Tests"
			]
		},
	]
}